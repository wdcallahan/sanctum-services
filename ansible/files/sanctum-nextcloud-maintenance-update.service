[Unit]
Description=Sanctum Nextcloud — qualified within-34 maintenance update cycle
Documentation=https://github.com/wdcallahan/sanctum-services/blob/main/docs/runbooks/nextcloud-instance-recovery.md

[Service]
Type=oneshot
WorkingDirectory=/home/wdc2/src/sanctum-services
Environment=HOME=/home/wdc2
Environment=PATH=/home/wdc2/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
# Shared with the independent weekly backup timer: do not overlap an active
# application-consistent snapshot, Peanut custody or running patch upgrade.
ExecStart=/usr/bin/flock -n /home/wdc2/.local/share/sanctum-services/backups/nextcloud/.nextcloud-cycle.lock /usr/bin/env ansible-playbook -i ansible/inventory/hosts.yml ansible/nextcloud-maintenance-cycle.yml -e nextcloud_maintenance_cycle_approved=true -e nextcloud_maintenance_activation_approved=true
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

[Unit]
Description=Sanctum Nextcloud — consistent source and independent Peanut backup
Documentation=https://github.com/wdcallahan/sanctum-services/blob/main/docs/runbooks/nextcloud-instance-recovery.md

[Service]
Type=oneshot
WorkingDirectory=/home/wdc2/src/sanctum-services
Environment=HOME=/home/wdc2
Environment=PATH=/home/wdc2/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
# No concurrent scheduled snapshot. The exact lock parent already exists
# from our accepted native Kvin recovery point. Do not hide a busy-lock exit.
ExecStart=/usr/bin/flock -n /home/wdc2/.local/share/sanctum-services/backups/nextcloud/.nextcloud-cycle.lock /usr/bin/env ansible-playbook -i ansible/inventory/hosts.yml ansible/nextcloud-scheduled-backup.yml -e nextcloud_scheduled_backup_approved=true
TimeoutStartSec=0
StandardOutput=journal
StandardError=journal

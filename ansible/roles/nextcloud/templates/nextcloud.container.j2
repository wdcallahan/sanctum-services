[Unit]
Description=Sanctum Nextcloud (Apache, rootless Podman)

[Container]
# Only the Services backup-gated maintenance workflow may refresh this image.
# Do not add AutoUpdate=registry: the shared user timer cannot guarantee a
# consistent app + Maintenance-owned PostgreSQL backup and Peanut custody.
Image={{ nextcloud_image }}
Pull=never
ContainerName=sanctum-nextcloud
# Preserve the accepted working rootless PostgreSQL transport.
Network=slirp4netns
PublishPort=0.0.0.0:{{ nextcloud_host_port }}:80/tcp
Volume={{ nextcloud_html_dir }}:/var/www/html
Volume={{ nextcloud_private_config_dir }}/postgresql-password:/run/secrets/nextcloud-postgresql-password:ro
Volume={{ nextcloud_private_config_dir }}/postgresql-database:/run/secrets/nextcloud-postgresql-database:ro
Volume={{ nextcloud_private_config_dir }}/postgresql-username:/run/secrets/nextcloud-postgresql-username:ro
EnvironmentFile={{ nextcloud_private_config_dir }}/nextcloud.env

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target

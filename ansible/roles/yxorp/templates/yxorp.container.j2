[Unit]
Description=Sanctum YXORP (rootful Nginx reverse proxy)
After=network-online.target
Wants=network-online.target

[Container]
Image={{ yxorp_image }}
ContainerName={{ yxorp_container_name }}
# Host networking deliberately shares the host resolver and listener
# path on both Peanut and Kvin. Nginx's "listen 80" publishes normal HTTP
# on all host IPv4 interfaces. Quadlet forbids PublishPort with Network=host.
Network=host
Volume={{ yxorp_active_config }}:/etc/nginx/nginx.conf:ro,Z

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target

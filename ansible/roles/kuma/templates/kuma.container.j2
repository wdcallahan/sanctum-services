[Unit]
Description=Sanctum retained Uptime Kuma (rootless Podman)
After=network-online.target
Wants=network-online.target

[Container]
Image={{ kuma_image }}
ContainerName={{ kuma_container_name }}
# Rootless network choice follows the qualified Kvin Nextcloud pattern;
# reachability from Kuma to Wicket must still pass independently.
Network=slirp4netns
PublishPort={{ kuma_bind_address }}:{{ kuma_host_port }}:3001/tcp
Volume={{ kuma_data_volume }}:/app/data
# The database backend is declared in source; administrator setup remains
# a one-time authenticated application operation with secret data in the volume.
Environment=UPTIME_KUMA_DB_TYPE={{ kuma_db_type }}

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
